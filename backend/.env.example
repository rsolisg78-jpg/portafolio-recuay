# Puerto local (Railway inyecta PORT automáticamente)
PORT=3000

# Postgres (en Railway: referenciar ${{Postgres.DATABASE_URL}}).
# Si se deja vacío, la API usa almacenamiento en memoria (ideal para desarrollo local).
DATABASE_URL=

# Secreto para firmar los JWT (generar uno distinto en producción):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-en-produccion

# Credenciales del docente (acceso total)
TEACHER_USER=docente
TEACHER_PASS=recuay26

# Orígenes permitidos (CORS). * para desarrollo; en producción poner el dominio del frontend.
FRONTEND_URL=*
